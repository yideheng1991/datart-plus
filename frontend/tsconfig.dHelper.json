{
  // Inherits the CRA compiler options so path aliases and modern lib
  // features resolve, then emits a CommonJS mirror of chartHelper.ts
  // (types/chartHelper.js) that feeds jsdoc for the dHelper API docs.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": false,
    "declarationMap": true,
    "outDir": "types",
    "rootDir": "src",
    // keep emitted JS parseable by jsdoc's espree (no post-ES2020 syntax)
    "target": "es2020",
    "module": "commonjs"
  },
  "include": ["src/app/utils/chartHelper.ts"]
}
